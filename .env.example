# Neon — DATABASE_URL is pooled (app runtime), DIRECT_URL is unpooled (migrations).
# Prisma Migrate fails through the pooler, so both are required.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require"

# Clerk — two instances. Local dev uses the pk_test_/sk_test_ development instance;
# production uses pk_live_/sk_live_ bound to clerk.vpn.zoiee.me. Never put live keys in a
# local .env.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# 32 random bytes, base64. Encrypts configs.encrypted_privkey, configs.encrypted_conf and
# nodes.agent_token (SPEC §9). MUST live outside Neon — a DB leak with this key in it hands
# over every client tunnel. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=""
