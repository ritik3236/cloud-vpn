# Neon — DATABASE_URL is pooled (app runtime), DIRECT_URL is unpooled (migrations).
# Prisma Migrate fails through the pooler, so both are required.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Clerk — this project uses the PRODUCTION instance (clerk.vpn.zoiee.me) everywhere, local
# dev included. Signing in locally bounces to https://accounts.vpn.zoiee.me and redirects back
# to localhost; if Clerk refuses that redirect, allow the localhost origin on the instance
# rather than introducing a second set of keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_live_..."
CLERK_SECRET_KEY="sk_live_..."

# 32 random bytes, base64. Encrypts configs.encrypted_privkey, configs.encrypted_conf and
# nodes.agent_token (SPEC §9). MUST live outside Neon — a DB leak with this key in it hands
# over every client tunnel. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=""
